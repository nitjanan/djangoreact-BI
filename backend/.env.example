# คัดลอกเป็น .env แล้วแก้ค่าตามเครื่อง
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=false

# หน้า React (ลิงก์ reset password และ CSRF trusted origin)
FRONTEND_URL=http://localhost:5173
# เปิดเว็บได้หลายชื่อ/IP: ใส่ทุก origin คั่นด้วย , (เว้นว่าง = ใช้ FRONTEND_URL)
CSRF_TRUSTED_ORIGINS=

# ฐานข้อมูลเดิม (MariaDB ใน XAMPP) — ตั้ง DB_ENGINE=sqlite เพื่อทดลองแบบไม่ใช้ MySQL
DB_ENGINE=mysql
DB_NAME=djangodashboarddb
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# อีเมล (ตอน DEBUG จะพิมพ์อีเมลออก console แทนการส่งจริง)
# เว้นว่าง = DEBUG พิมพ์ออก console, ไม่ DEBUG ส่งจริงผ่าน SMTP
# บังคับส่งจริงตอน DEBUG: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
# SMTP (เว้นว่าง = smtp-relay.brevo.com พอร์ต 587 แบบ TLS)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# webstock ที่ใช้ดึงใบแจ้งซ่อม: เว้นว่างเพื่อใช้ URL จากตาราง base_api
MAINTENANCE_API_BASE=
# webstock ที่ใช้ดึงงานจากบันทึกการใช้รถ (car_jobs): เว้นว่างเพื่อใช้ URL จากตาราง base_api
CARLOG_JOBS_API_BASE=
# รหัสลับของงานอัปเดตอัตโนมัติทุกวัน (ส่งใน header X-Sync-Token) ตั้งเป็นข้อความสุ่มยาว ๆ ว่าง = ปิด
SYNC_TOKEN=
# true = เปิด http://127.0.0.1:8003/update_summary_from_api/ บนเครื่อง server ได้โดยไม่ต้องใส่รหัส (แบบระบบเดิม)
# เปิดเฉพาะเมื่อ IIS/nginx บนเครื่องนี้ (ถ้ามี) ส่ง X-Forwarded-For ทุกคำขอ ไม่งั้นคนนอกสั่งดึงผ่าน proxy ได้
ALLOW_LOCAL_SYNC_WITHOUT_TOKEN=false
