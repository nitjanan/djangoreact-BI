{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "backend", "run", "python", "manage.py", "runserver", "127.0.0.1:8003"],
      "port": 8003
    },
    {
      "name": "webstock-local",
      "runtimeExecutable": "../djangostock/.venv/Scripts/python.exe",
      "runtimeArgs": ["../djangostock/manage.py", "runserver", "127.0.0.1:8000"],
      "port": 8000,
      "autoPort": false
    }
  ]
}
